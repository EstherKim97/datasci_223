    "def categorize_age(age):\n",
    "    if age < 1:\n",
    "        return \"Infant (<1 year)\"\n",
    "    elif age < 6:\n",
    "        return \"Young Child (1-5 years)\"\n",
    "    elif age < 13:\n",
    "        return \"Child (6-12 years)\"\n",
